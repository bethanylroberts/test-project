        IF TIME = . THEN DO;
           FLAG = 'TIME MISSING';
           BADVALUE = ' ';
           OUTPUT;
           END;
        IF VISIBLTY>20 THEN DO;
           FLAG = 'VISIBLTY TOO HIGH';
           BADVALUE = VISIBLTY;
           OUTPUT;
           END;
        IF LEGTYPE = . THEN DO;
           FLAG = 'LEGTYPE MISSING';
           BADVALUE = ' ';
           OUTPUT;
           END;
        IF LEGSTAGE NE . THEN DO;
           IF BEAUFORT = . THEN DO;
              FLAG = 'BEAUFORT MISSING';
              BADVALUE = ' ';
              OUTPUT;
              END;
           IF CLOUD = . THEN DO;
              FLAG = 'CLOUD COVER MISSING';
              BADVALUE = ' ';
              OUTPUT;
              END;
           if wx = ' ' then do;
              flag = 'WEATHER CODE MISSING';
              BADVALUE = ' ';
              OUTPUt;
              end;
           IF VISIBLTY = . THEN DO;
              FLAG = 'VISIBILITY MISSING';
              BADVALUE = ' ';
              OUTPUT;
              END;
           END;
        IF ((LAG(LEGSTAGE)=1 OR LAG(LEGSTAGE)=2) AND LEGSTAGE=.)
           THEN DO;
           FLAG = 'LEG STAGE MISSING';
           BADVALUE = ' ';
           OUTPUT;
           END;
        IF LEGTYPE NE . AND (LEGTYPE LT 5 OR LEGTYPE GT 6)
           THEN DO;
           FLAG = 'LEGTYPE OUT OF RANGE';
           BADVALUE = LEGTYPE;
           OUTPUT;
           END;
        IF LEGSTAGE NE . AND
           ((LEGSTAGE NE 1 AND LEGSTAGE NE 2 AND LEGSTAGE NE 5)

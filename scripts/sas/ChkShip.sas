     LAT = (LATDEG + LATMIN/60)/57.29678;
     LONG = (LONGDEG + LONGMIN/60)/57.29678;
     TIMEHR = INT(TIME/10000);
     TIMEMIN = INT((TIME - 10000*TIMEHR)/100);
     TIMESEC = TIME - 10000*TIMEHR - 100*TIMEMIN;
     pday = lag1(day);
     pmonth = lag1(month);
     if pmonth ne month and eventno>1 then do;
        flag = 'MONTH MISMATCH';
        badvalue = month;
        output;
        end;
     if pday ne day and eventno>1 then do;
        flag = 'DAY MISMATCH';
        badvalue = day;
        output;
        end;
     IF TIMEMIN GT 59 THEN DO;
        FLAG = 'TIME MINUTES OUT OF RANGE';
        BADVALUE = TIME;
        OUTPUT;
        END;
     IF TIMESEC GT 59 THEN DO;
        FLAG = 'TIME SECONDS OUT OF RANGE';
        BADVALUE = TIME;
        OUTPUT;
        END;
     TIME2 = TIMEHR + TIMEMIN/60 + TIMESEC/3600;
     PREVLAT = LAG(LAT);
     PREVLONG = LAG(LONG);
     PREVDAY = LAG(DAY);
     PREVTIME = LAG(TIME2);
     DISTANCE = 60 * 57.29678 * ARCOS((SIN(PREVLAT) *
                SIN(LAT)) + (COS(PREVLAT) * COS(LAT)) *
                COS(LONG - PREVLONG));
     IF DAY = PREVDAY THEN DO;
        ETIME = TIME2 - PREVTIME;
        END;
     ELSE DO;
        ETIME = TIME2 + 24*(DAY-PREVDAY) - PREVTIME;
        END;
     IF ETIME = 0 THEN ETIME = 0.00833;
     ELSE IF (ETIME NE . AND ETIME LT 0) THEN DO;
        FLAG = 'TIMES OUT OF ORDER';
        BADVALUE = ETIME;
        OUTPUT;
        END;
     ELSE IF (ETIME>0.50 AND (LEGSTAGE=2 OR LEGSTAGE=5)) THEN DO;
        FLAG = '>30 MINUTES WITHOUT A POSITION';
        BADVALUE = ETIME*60;
        OUTPUT;
        END;
     SPEED = DISTANCE/ETIME;
        IF ALT > 0 THEN DO;
           FLAG = 'VESSEL IS AIRBORNE!!!';
           BADVALUE = ALT;
           OUTPUT;
           END;
        IF DAY = . THEN DO;
           FLAG = 'DAY MISSING';
           BADVALUE = ' ';

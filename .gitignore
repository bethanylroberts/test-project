data/*
!data/tables
reports/
logs/
pub/

# MATLAB
*.asv
*.m~
slprj/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
*.code-workspace

# Database
*.db
*.sqlite

# Secrets
config/db_config.m
*.env

# Local config (contains credentials — gitignored)
config/local/*
!config/local/.gitkeep
!config/local/db_config.local.m.template

